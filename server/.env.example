# Isi dengan NAMA variabel saja di sini. Nilai asli hanya di environment Vercel (atau server/.env.local untuk vercel dev).
# Jangan pernah meng-commit nilai rahasia.

# Isi file JSON service account Firebase yang di-base64 (lihat server/README.md).
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Midtrans Sandbox (Dashboard Midtrans > Settings > Access Keys).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Kunci untuk memverifikasi signature_key webhook (aturan sejak 28 Okt 2026). BUKAN server key.
MIDTRANS_SIGNATURE_SECRET_KEY=
MIDTRANS_IS_PRODUCTION=false

# Nominal denda per keterlambatan (rupiah, bilangan bulat).
DENDA_NOMINAL=5000
