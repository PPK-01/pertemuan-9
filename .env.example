# Firebase Configuration (Spark Plan)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Kode undangan asisten untuk scripts/seed-firebase.js.
# Jangan diberi awalan EXPO_PUBLIC_: variabel berawalan itu ikut tertanam di bundle aplikasi.
# Tidak dikirim ke EAS oleh scripts/setup-eas-secrets.sh.
ASISTEN_INVITE_CODE=

# Sprint 4: URL dasar backend Vercel (tanpa slash di akhir), mis. https://rawuh-api.vercel.app
# Tidak berisi rahasia; kunci Midtrans dan service account hanya di environment Vercel (lihat server/README.md).
EXPO_PUBLIC_API_BASE_URL=
